{
  "expo": {
    "name": "Tether",
    "slug": "tether",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tether",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5E6D3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tether.app",
      "usesAppleSignIn": true,
      "appleTeamId": "K9SD42GFJG",
      "infoPlist": {
        "NSCameraUsageDescription": "Tether needs access to your camera to take profile photos.",
        "NSPhotoLibraryUsageDescription": "Tether needs access to your photo library to select profile photos.",
        "NSPhotoLibraryAddUsageDescription": "Tether needs permission to save photos to your library.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["tether"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "package": "com.tether.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "tether"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tether needs access to your photos to set your profile picture.",
          "cameraPermission": "Tether needs access to your camera to take profile photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleWebClientId": "251990719722-0u7bqse5r4pkvklfbfgivihvmrh63uf6.apps.googleusercontent.com",
      "googleIosClientId": "251990719722-4339ehd9uphkoplb6fs0d96j3q38h1el.apps.googleusercontent.com",
      "apiUrl": "https://9l2k8cwj-3000.inc1.devtunnels.ms"
    }
  }
}