{
  "expo": {
    "name": "Tether",
    "slug": "tether",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tether",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#FF6B35",
      "androidMode": "default",
      "androidCollapsedTitle": "#{unread_notifications} new notifications"
    },
    "splash": {
      "image": "./assets/images/Splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5E6D3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inzint.tetherapp",
      "usesAppleSignIn": true,
      "appleTeamId": "K9SD42GFJG",
      "infoPlist": {
        "NSCameraUsageDescription": "Tether needs access to your camera to take profile photos.",
        "NSPhotoLibraryUsageDescription": "Tether needs access to your photo library to select profile photos.",
        "NSPhotoLibraryAddUsageDescription": "Tether needs permission to save photos to your library.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "tether"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json",
      "package": "com.tether.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "useNextNotificationsApi": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "tether"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tether needs access to your photos to set your profile picture.",
          "cameraPermission": "Tether needs access to your camera to take profile photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF6B35",
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleWebClientId": "251990719722-0u7bqse5r4pkvklfbfgivihvmrh63uf6.apps.googleusercontent.com",
      "googleIosClientId": "251990719722-4339ehd9uphkoplb6fs0d96j3q38h1el.apps.googleusercontent.com",
      "googleAndroidClientId": "251990719722-5jegc1q6gpthpmvttdh4ah13hlg4o25c.apps.googleusercontent.com",
      "apiUrl": "http://192.168.29.107:3000",
      "router": {},
      "eas": {
        "projectId": "2eb6e92a-7dbc-4bfb-b6fe-eee2f3c2a708"
      }
    }
  }
}